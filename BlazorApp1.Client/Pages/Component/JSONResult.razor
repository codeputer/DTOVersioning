@* A reusable component for displaying a JSON textarea, a button, and a result area *@
<div>
    <label for="@TextAreaId"><b>@Label</b></label><br />
    <textarea id="@TextAreaId" rows="10" style="width:100%;" @bind="CustomerJson"></textarea>
    <button class="btn btn-primary" @onclick="OnButtonClick">@ButtonLabel</button>
    <div>@DeserializationResult</div>
</div>


